			},
			"referenceOutputs": {
				"turns": [
					{
						"behavior": "answer",
						"facts": { "orderId": "A1024", "paidAmountYuan": 3500 },
						"criteria": [
							"查询当前用户的订单，回答 A1024 的实付金额为 3500 元。"
						]
					},
					{
						"behavior": "answer",
						"facts": {
							"orderId": "A1024",
							"refundAmountYuan": 3500,
							"requiresManualReview": true,
							"policyId": "refund-rule-v1"
						},
						"criteria": [
							"在同一会话中沿用 A1024，将全额退款对应到 3500 元。",
							"根据退款规则说明必须人工审核，不声称已提交申请。"
						]
