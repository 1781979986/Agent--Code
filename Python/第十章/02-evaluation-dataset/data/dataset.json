						"criteria": [
							"根据规则说明：正好 2000 元未触发超过 2000 元的门槛。",
							"不承诺退款资格、自动到账或申请已经提交。"
						]
					}
				]
			}
		},
		{
			"id": "refund-over-threshold",
			"name": "退款金额超过 2000 元",
			"fixtureId": "after-sales-fixture-v1",
			"inputs": {
